<Application
    x:Class="Lotus.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lotus">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Remove XamlControlsResources for safety test if needed, but keeping it is better for controls -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Base Colors -->
            <Color x:Key="AeroGreenColor">#22C55E</Color>
            <SolidColorBrush x:Key="AeroAccentPrimaryBrush" Color="{StaticResource AeroGreenColor}"/>
            <SolidColorBrush x:Key="AeroGlassBrush" Color="#AAFFFFFF" />
            <LinearGradientBrush x:Key="AeroTitleBarGradient" StartPoint="0,0" EndPoint="0,1">
                 <GradientStop Color="#FFFFFF" Offset="0"/>
                 <GradientStop Color="#F0F0F0" Offset="1"/>
            </LinearGradientBrush>

             <!-- Styles -->
            <Style x:Key="AeroTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="AeroThemeComboBox" TargetType="ComboBox" />
            
            <Style x:Key="AeroGlassPanel" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AeroGlassBrush}"/>
                <Setter Property="BorderBrush" Value="#44000000"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <Style x:Key="AeroSectionHeaderStyle" TargetType="TextBlock">
                 <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            
            <Style x:Key="AeroSectionHeader" TargetType="Border">
                <Setter Property="Background" Value="#22C55E"/>
            </Style>

            <Style x:Key="AeroBodyStyle" TargetType="TextBlock">
                 <Setter Property="FontSize" Value="14"/>
            </Style>
            
            <Style x:Key="AeroCaptionStyle" TargetType="TextBlock">
                 <Setter Property="FontSize" Value="12"/>
                 <Setter Property="Foreground" Value="Gray"/>
            </Style>

            <Style x:Key="AeroVerticalBarStyle" TargetType="ProgressBar">
                 <Setter Property="Width" Value="10"/>
            </Style>
            
            <Style x:Key="AeroScrollViewerStyle" TargetType="ScrollViewer"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
