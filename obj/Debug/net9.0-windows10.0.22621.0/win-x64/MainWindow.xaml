<Window
    x:Class="Lotus.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Lotus"
    mc:Ignorable="d">

    <Border x:ConnectionId='2' x:Name="AppRoot" 
            Background="{StaticResource AeroGlassBrush}"
            BorderBrush="#40FFFFFF"
            BorderThickness="1">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- TitleBar -->
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
            </Grid.RowDefinitions>

            <!-- CUSTOM TITLE BAR -->
            <Grid x:ConnectionId='3' x:Name="HeaderBorder" Height="40" Background="Transparent" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                    <TextBlock Text="LOTUS" Style="{StaticResource AeroCaptionStyle}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- HEADER AREA -->
            <Grid Grid.Row="1" Margin="24,12,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="LOTUS_ICON" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="LOTUS" 
                               Style="{StaticResource AeroTitleStyle}" 
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <ComboBox x:ConnectionId='27' x:Name="ThemeSelector" 
                          Grid.Column="1" 
                          Style="{StaticResource AeroThemeComboBox}"
                          Width="120"
                                                                           >
                    <ComboBoxItem Content="Forest" Tag="forest" IsSelected="True"/>
                    <ComboBoxItem Content="Ocean" Tag="ocean"/>
                    <ComboBoxItem Content="Sakura" Tag="sakura"/>
                    <ComboBoxItem Content="Sunset" Tag="sunset"/>
                    <ComboBoxItem Content="Midnight" Tag="midnight"/>
                    <ComboBoxItem Content="Snow" Tag="snow"/>
                </ComboBox>
            </Grid>

            <!-- MAIN CONTENT SCROLLVIEWER -->
            <ScrollViewer Grid.Row="2" Style="{StaticResource AeroScrollViewerStyle}">
                <StackPanel Spacing="16" Padding="24,0,24,24">
                    
                    <!-- MASCOT & VISUALIZATION -->
                    <Grid Height="200">
                        <Canvas x:ConnectionId='10' x:Name="MascotContainer" 
                                Width="200" 
                                Height="200" 
                                HorizontalAlignment="Center"
                                                                               
                                                                               
                                                                             
                                Background="Transparent">
                                
                            <!-- Floating & Scaling handled in code -->
                            <Ellipse x:ConnectionId='21' x:Name="MascotGlow" Width="160" Height="160" Fill="#22C55E" Opacity="0.2" Canvas.Left="20" Canvas.Top="20">
                                <Ellipse.RenderTransform>
                                    <CompositeTransform TranslateX="0" TranslateY="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <Ellipse x:ConnectionId='22' x:Name="MascotBody" Width="120" Height="120" Fill="#22C55E" Canvas.Left="40" Canvas.Top="40"/>
                            <Ellipse x:ConnectionId='23' x:Name="MascotHead" Width="100" Height="90" Fill="#22C55E" Canvas.Left="50" Canvas.Top="20"/>
                            
                            <!-- FACE -->
                            <Ellipse x:ConnectionId='24' x:Name="LeftEye" Width="8" Height="8" Fill="#1E293B" Canvas.Left="75" Canvas.Top="50"/>
                            <Ellipse x:ConnectionId='25' x:Name="RightEye" Width="8" Height="8" Fill="#1E293B" Canvas.Left="115" Canvas.Top="50"/>
                            
                            <TextBlock x:ConnectionId='26' x:Name="MascotExpression" 
                                       Text="" 
                                       Foreground="#1E293B" 
                                       FontSize="24" 
                                       Canvas.Left="95" 
                                       Canvas.Top="60"/>
                        </Canvas>

                        <!-- AUDIO VISUALIZATION BARS -->
                        <StackPanel x:ConnectionId='11' x:Name="AudioVisualizer" 
                                    Orientation="Horizontal" 
                                    Spacing="4" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Bottom" 
                                    Margin="0,0,20,20">
                            <ProgressBar x:ConnectionId='16' x:Name="Bar1" Width="8" Height="40" Value="0.2" Style="{StaticResource AeroVerticalBarStyle}"/>
                            <ProgressBar x:ConnectionId='17' x:Name="Bar2" Width="8" Height="60" Value="0.4" Style="{StaticResource AeroVerticalBarStyle}"/>
                            <ProgressBar x:ConnectionId='18' x:Name="Bar3" Width="8" Height="75" Value="0.6" Style="{StaticResource AeroVerticalBarStyle}"/>
                            <ProgressBar x:ConnectionId='19' x:Name="Bar4" Width="8" Height="50" Value="0.3" Style="{StaticResource AeroVerticalBarStyle}"/>
                            <ProgressBar x:ConnectionId='20' x:Name="Bar5" Width="8" Height="30" Value="0.1" Style="{StaticResource AeroVerticalBarStyle}"/>
                        </StackPanel>

                        <!-- STATUS BUBBLE -->
                        <Border x:ConnectionId='12' x:Name="StatusBubble" 
                                Style="{StaticResource AeroGlassPanel}" 
                                HorizontalAlignment="Left" 
                                VerticalAlignment="Top" 
                                Margin="0,10,0,0"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="8" Height="8" Fill="#10B981"/>
                                <TextBlock x:ConnectionId='15' x:Name="MascotStatusText" Text=" idle..." FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- SECRET MESSAGE POPUP -->
                        <Border x:ConnectionId='13' x:Name="SecretMessagePopup"
                                Style="{StaticResource AeroGlassPanel}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#EEF2FF"
                                BorderBrush="#6366F1"
                                Visibility="Collapsed">
                            <TextBlock x:ConnectionId='14' x:Name="SecretMessageText" 
                                       Text="Secret!" 
                                       Foreground="#4338CA" 
                                       FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <!-- DAILY MESSAGE -->
                    <Border Style="{StaticResource AeroGlassPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Style="{StaticResource AeroSectionHeader}">
                                <TextBlock Text="Daily Message" Style="{StaticResource AeroSectionHeaderStyle}"/>
                            </Border>
                            
                            <TextBlock x:ConnectionId='9' x:Name="DailyMessageText" 
                                       Grid.Row="1" 
                                       Style="{StaticResource AeroBodyStyle}" 
                                       Margin="16,12"
                                       Text="Loading..."/>
                        </Grid>
                    </Border>

                    <!-- HIM NOTE -->
                    <Border Style="{StaticResource AeroGlassPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Style="{StaticResource AeroSectionHeader}">
                                <TextBlock Text="From Ivan" Style="{StaticResource AeroSectionHeaderStyle}"/>
                            </Border>
                            
                            <TextBlock x:ConnectionId='8' x:Name="HimNoteText" 
                                       Grid.Row="1" 
                                       Style="{StaticResource AeroBodyStyle}" 
                                       Margin="16,12"
                                       FontStyle="Italic"
                                       Opacity="0.9"/>
                        </Grid>
                    </Border>

                    <!-- ELI NOTE -->
                    <Border Style="{StaticResource AeroGlassPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Style="{StaticResource AeroSectionHeader}">
                                <Grid>
                                    <TextBlock Text="Eli's Space" Style="{StaticResource AeroSectionHeaderStyle}"/>
                                    <Button x:ConnectionId='7' x:Name="ClearNoteButton" 
                                            Content="Clear" 
                                            HorizontalAlignment="Right"
                                            FontSize="10"
                                            Margin="0,0,8,0"
                                                                         />
                                </Grid>
                            </Border>
                            
                            <TextBox x:ConnectionId='6' x:Name="EliNoteTextBox"
                                     Grid.Row="1" 
                                     Margin="0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     PlaceholderText="Type something..."
                                                                             />
                        </Grid>
                    </Border>

                     <!-- CONTROL PANEL -->
                    <Border Style="{StaticResource AeroGlassPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Style="{StaticResource AeroSectionHeader}">
                                <Grid>
                                    <TextBlock Text="Audio Guardian" Style="{StaticResource AeroSectionHeaderStyle}"/>
                                    <ToggleButton x:ConnectionId='5' x:Name="PowerToggle" 
                                                  Content="ON" 
                                                  IsChecked="True"
                                                  HorizontalAlignment="Right"
                                                  Margin="0,0,8,0"
                                                                           />
                                </Grid>
                            </Border>
                            
                            <StackPanel Grid.Row="1" Padding="16,12" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Status:" Style="{StaticResource AeroCaptionStyle}" VerticalAlignment="Center"/>
                                    <TextBlock x:ConnectionId='4' x:Name="AudioStatusText" Text="Active" Style="{StaticResource AeroBodyStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>

